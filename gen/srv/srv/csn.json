      "enum": {
        "LOW": {
          "val": "LOW"
        },
        "MEDIUM": {
          "val": "MEDIUM"
        },
        "HIGH": {
          "val": "HIGH"
        },
        "CRITICAL": {
          "val": "CRITICAL"
        }
      }
    },
    "petrobras.maintenance.Equipment": {
      "kind": "entity",
      "includes": [
        "cuid",
        "managed"
      ],
      "elements": {
        "ID": {
          "key": true,
