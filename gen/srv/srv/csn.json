          "length": 100
        },
        "plant": {
          "type": "cds.String",
          "length": 10
        },
        "orders": {
          "type": "cds.Association",
          "cardinality": {
            "max": "*"
          },
          "target": "petrobras.maintenance.MaintenanceOrder",
          "on": [
            {
              "ref": [
                "orders",
                "equipment"
              ]
            },
            "=",
            {
              "ref": [
                "$self"
              ]
            }
