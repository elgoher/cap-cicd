    "petrobras.maintenance.EquipmentStatus": {
      "kind": "type",
      "type": "cds.String",
      "length": 20,
      "enum": {
        "ACTIVE": {
          "val": "ACTIVE"
        },
        "INACTIVE": {
          "val": "INACTIVE"
        },
        "DECOMMISSIONED": {
          "val": "DECOMMISSIONED"
        }
      }
    },
    "petrobras.maintenance.OrderStatus": {
      "kind": "type",
      "type": "cds.String",
      "length": 20,
      "enum": {
        "DRAFT": {
          "val": "DRAFT"
        },
        "OPEN": {
          "val": "OPEN"
        },
        "IN_PROGRESS": {
          "val": "IN_PROGRESS"
        },
        "COMPLETED": {
          "val": "COMPLETED"
        },
        "CANCELLED": {
          "val": "CANCELLED"
        }
      }
    },
    "petrobras.maintenance.WorkItemStatus": {
